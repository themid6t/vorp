# Example systemd unit for the relay. The settings live in /etc/vorp/vorp.yaml
# (see deploy/vorp.yaml); install both:
#   sudo install -m 0644 deploy/vorp.yaml /etc/vorp/vorp.yaml   # then edit it
#   sudo install -m 0644 deploy/vorp.service /etc/systemd/system/vorp.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now vorp
# It expects a `vorp` system user, the binary from install.sh, the
# certificate copied to /etc/vorp by deploy/cert-deploy.sh, and /var/lib/vorp
# owned by vorp. Config changes need `sudo systemctl restart vorp`.
#
# An older unit that passes every setting as a flag keeps working: flags win
# over the file, and a missing /etc/vorp/vorp.yaml is not an error.
[Unit]
Description=Vorp reverse tunnel relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vorp
Group=vorp
WorkingDirectory=/var/lib/vorp
# Plain log lines in the journal, without terminal colour codes.
Environment=NO_COLOR=1
ExecStart=/usr/local/bin/vorp serve --config /etc/vorp/vorp.yaml
Restart=on-failure
# Restarting faster than reconnecting agents spread out (0-5s) re-forms the herd.
RestartSec=5s
# Above limits.max_connections (default 1024); systemd's soft default is 1024.
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/vorp

[Install]
WantedBy=multi-user.target
